rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // =========================================================
    // AUTH
    // =========================================================

    function signedIn() {
      return request.auth != null;
    }

    function userExists() {
      return signedIn()
      && exists(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function currentUser() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    // =========================================================
    // SALON
    // =========================================================
    //
    // Nell'app il ruolo del Salon è "admin".
    //
    // Employee NON è un utente autenticato.
    //
    // =========================================================

    function isSalon() {
      return userExists()
      && currentUser().data.role == "admin"
      && currentUser().data.salonId is string
      && currentUser().data.salonId != "";
    }

    function ownsSalon(salonId) {
      return isSalon()
      && currentUser().data.salonId == salonId;
    }

    // =========================================================
    // USER / CUSTOMER
    // =========================================================
    //
    // Nell'app il cliente finale è "customer".
    //
    // =========================================================

    function isUser() {
      return userExists()
      && currentUser().data.role == "customer";
    }

    function isOwnUser(userId) {
      return signedIn()
      && request.auth.uid == userId;
    }


    // =========================================================
    // USERS
    // =========================================================

    match /users/{userId} {

      // -------------------------------------------------------
      // READ
      // -------------------------------------------------------

      // Un User può leggere il proprio profilo.
      //
      // Un Salon può leggere i profili necessari alla propria
      // gestione.
      allow read: if
      isOwnUser(userId)
      || isSalon();


      // -------------------------------------------------------
      // CREATE
      // -------------------------------------------------------

      // Il documento users/{uid} può essere creato solamente
      // dall'utente autenticato corrispondente.
      //
      // I soli ruoli applicativi ammessi sono:
      // - admin
      // - customer
      //
      // Il ruolo non può quindi essere arbitrario.

      allow create: if
      isOwnUser(userId)
      && request.resource.data.role is string
      && (
        request.resource.data.role == "admin"
        || request.resource.data.role == "customer"
      );


      // -------------------------------------------------------
      // UPDATE
      // -------------------------------------------------------

      // L'utente può modificare solamente i propri dati
      // personali.
      //
      // NON può modificare:
      // - role
      // - salonId
      // - altri campi strutturali
      //
      allow update: if
      isOwnUser(userId)
      && request.resource.data.role == resource.data.role
      && request.resource.data.salonId == resource.data.salonId
      && request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasOnly([
        "name",
        "email",
        "phone",
        "photoUrl"
      ]);


      // -------------------------------------------------------
      // DELETE
      // -------------------------------------------------------

      // I profili non vengono eliminati dal client.
      allow delete: if false;
    }


    // =========================================================
    // SALONS
    // =========================================================

    match /salons/{salonId} {

      // I dati del salone sono necessari anche al cliente.
      allow read: if signedIn();


      // -------------------------------------------------------
      // CREATE
      // -------------------------------------------------------

      // Durante la registrazione il Salon viene creato prima
      // del documento users/{uid}.
      //
      // Per questo NON possiamo utilizzare ownsSalon() qui:
      // il profilo users/{uid} potrebbe non esistere ancora.
      //
      // Il documento deve comunque appartenere allo stesso
      // account Firebase che lo sta creando.
      //
      allow create: if
      signedIn()
      && request.auth.uid == salonId;


      // -------------------------------------------------------
      // UPDATE
      // -------------------------------------------------------

      // Il Salon può modificare solamente il proprio documento.
      //
      // I campi ammessi corrispondono al SalonModel attuale.

      allow update: if
      ownsSalon(salonId)
      && request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasOnly([
        "name",
        "address",
        "city",
        "imageUrl",
        "rating",
        "reviewCount",
        "phone",
        "description",
        "openingHour",
        "closingHour",
        "closedWeekdays",
        "closedDates",
        "active",
        "taxIdType",
        "taxId"
      ]);


      // -------------------------------------------------------
      // DELETE
      // -------------------------------------------------------

      // Un Salon può eliminare solamente il proprio documento.
      allow delete: if ownsSalon(salonId);


      // =======================================================
      // EMPLOYEES
      // =======================================================

      // Employee NON è un account Firebase.
      //
      // È semplicemente una persona appartenente al team
      // del Salon.
      //
      // Il cliente può leggerli perché sono necessari
      // alla prenotazione.

      match /employees/{employeeId} {

        allow read: if signedIn();

        allow create, update, delete: if
        ownsSalon(salonId);
      }


      // =======================================================
      // SERVICES
      // =======================================================

      match /services/{serviceId} {

        allow read: if signedIn();

        allow create, update, delete: if
        ownsSalon(salonId);
      }


      // =======================================================
      // REVIEWS
      // =======================================================

      match /reviews/{reviewId} {

        allow read: if signedIn();


        // -----------------------------------------------------
        // CREATE
        // -----------------------------------------------------

        // Solo il cliente autenticato può creare una recensione
        // per sé stesso e per il salone indicato.

        allow create: if
        isUser()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.salonId == salonId;


        // -----------------------------------------------------
        // UPDATE / DELETE
        // -----------------------------------------------------

        // Il Salon può gestire solamente le recensioni
        // del proprio salone.

        allow update, delete: if
        ownsSalon(salonId);
      }


      // =======================================================
      // NESTED APPOINTMENTS
      // =======================================================

      match /appointments/{appointmentId} {

        // -----------------------------------------------------
        // READ
        // -----------------------------------------------------

        allow read: if
        signedIn()
        && (
          (
            isUser()
            && resource.data.userId == request.auth.uid
          )
          ||
          ownsSalon(salonId)
        );


        // -----------------------------------------------------
        // CREATE
        // -----------------------------------------------------

        // Gli appuntamenti nested sono creati dal Salon.
        allow create: if
        ownsSalon(salonId);


        // -----------------------------------------------------
        // UPDATE / DELETE
        // -----------------------------------------------------

        allow update, delete: if
        ownsSalon(salonId);
      }
    }


    // =========================================================
    // ROOT APPOINTMENTS
    // =========================================================

    match /appointments/{appointmentId} {

      // -------------------------------------------------------
      // READ
      // -------------------------------------------------------

      // User:
      // solamente i propri appuntamenti.
      //
      // Salon:
      // solamente gli appuntamenti del proprio salone.

      allow read: if
      signedIn()
      && (
        (
          isUser()
          && resource.data.userId == request.auth.uid
        )
        ||
        (
          isSalon()
          && resource.data.salonId == currentUser().data.salonId
        )
      );


      // -------------------------------------------------------
      // CREATE
      // -------------------------------------------------------

      // User:
      // può creare un appuntamento per sé stesso.
      //
      // Salon:
      // può creare appuntamenti appartenenti al proprio salone.

      allow create: if
      signedIn()
      && (
        (
          isUser()
          && request.resource.data.userId == request.auth.uid
        )
        ||
        (
          isSalon()
          && request.resource.data.salonId
          == currentUser().data.salonId
        )
      );


      // -------------------------------------------------------
      // UPDATE
      // -------------------------------------------------------

      // Il Salon può modificare solamente appuntamenti
      // appartenenti al proprio salone.

      allow update: if
      isSalon()
      && resource.data.salonId
      == currentUser().data.salonId;


      // -------------------------------------------------------
      // DELETE
      // -------------------------------------------------------

      // Il Salon può eliminare solamente appuntamenti
      // appartenenti al proprio salone.

      allow delete: if
      isSalon()
      && resource.data.salonId
      == currentUser().data.salonId;
    }


    // =========================================================
    // APPOINTMENT REQUESTS
    // =========================================================

    match /appointment_requests/{requestId} {

      // -------------------------------------------------------
      // READ
      // -------------------------------------------------------

      // Salon:
      // solamente Request appartenenti al proprio salone.
      //
      // User:
      // solamente Request di cui è customerId.

      allow read: if
      signedIn()
      && (
        (
          isSalon()
          && resource.data.salonId
          == currentUser().data.salonId
        )
        ||
        (
          isUser()
          && resource.data.customerId
          == request.auth.uid
        )
      );


      // -------------------------------------------------------
      // CREATE
      // -------------------------------------------------------

      // Le Request vengono create dal Salon.
      //
      // Employee NON può crearle perché non è autenticato.
      //
      // Il customer non può inventarsi una Request.

      allow create: if
      isSalon()
      && request.resource.data.id == requestId
      && request.resource.data.salonId
      == currentUser().data.salonId
      && request.resource.data.customerId is string
      && request.resource.data.customerId != ""
      && request.resource.data.appointmentId is string
      && request.resource.data.appointmentId != ""
      && request.resource.data.createdBy == "admin"
      && request.resource.data.status == "draft"
      && request.resource.data.type is string
      && request.resource.data.priority is string
      && request.resource.data.payload is map;


      // -------------------------------------------------------
      // UPDATE
      // -------------------------------------------------------

      // SALON
      //
      // Il Salon può modificare solamente:
      // - status
      // - updatedAt
      //
      // Tutti gli altri dati identificativi della Request
      // rimangono immutabili.
      //
      // Transizioni consentite:
      //
      // draft
      //   -> pendingCustomer
      //
      // pendingCustomer
      //   -> cancelled
      //   -> expired

      allow update: if
      (
        isSalon()
        && resource.data.salonId
        == currentUser().data.salonId

        && request.resource.data.salonId
        == resource.data.salonId

        && request.resource.data.customerId
        == resource.data.customerId

        && request.resource.data.appointmentId
        == resource.data.appointmentId

        && request.resource.data.createdBy
        == resource.data.createdBy

        && request.resource.data.type
        == resource.data.type

        && request.resource.data.priority
        == resource.data.priority

        && request.resource.data.payload
        == resource.data.payload

        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
          "status",
          "updatedAt"
        ])

        && (
          (
            resource.data.status == "draft"
            && request.resource.data.status
            == "pendingCustomer"
          )
          ||
          (
            resource.data.status == "pendingCustomer"
            && (
              request.resource.data.status == "cancelled"
              ||
              request.resource.data.status == "expired"
            )
          )
        )
      )

      ||

      // USER
      //
      // Il cliente può solamente rispondere a una Request
      // pendente.
      //
      // Transizioni consentite:
      //
      // pendingCustomer
      //   -> accepted
      //   -> rejected

      (
        isUser()
        && resource.data.customerId
        == request.auth.uid

        && request.resource.data.salonId
        == resource.data.salonId

        && request.resource.data.customerId
        == resource.data.customerId

        && request.resource.data.appointmentId
        == resource.data.appointmentId

        && request.resource.data.createdBy
        == resource.data.createdBy

        && request.resource.data.type
        == resource.data.type

        && request.resource.data.priority
        == resource.data.priority

        && request.resource.data.payload
        == resource.data.payload

        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
          "status",
          "updatedAt"
        ])

        && resource.data.status == "pendingCustomer"

        && (
          request.resource.data.status == "accepted"
          ||
          request.resource.data.status == "rejected"
        )
      );


      // -------------------------------------------------------
      // DELETE
      // -------------------------------------------------------

      // Le Request non vengono cancellate dal client.
      allow delete: if false;


      // =======================================================
      // REQUEST TIMELINE
      // =======================================================

      match /timeline/{eventId} {

        // -----------------------------------------------------
        // READ
        // -----------------------------------------------------

        // Stessa visibilità della Request padre.

        allow read: if
        signedIn()
        && (
          (
            isSalon()
            &&
            get(
              /databases/$(database)/documents/appointment_requests/$(requestId)
            ).data.salonId
            == currentUser().data.salonId
          )
          ||
          (
            isUser()
            &&
            get(
              /databases/$(database)/documents/appointment_requests/$(requestId)
            ).data.customerId
            == request.auth.uid
          )
        );


        // -----------------------------------------------------
        // UPDATE / DELETE
        // -----------------------------------------------------

        // Timeline APPEND ONLY.
        //
        // Una volta creato un evento:
        // - non può essere modificato
        // - non può essere cancellato

        allow update, delete: if false;


        // -----------------------------------------------------
        // CREATE - SALON
        // -----------------------------------------------------

        // Gli eventi possono essere aggiunti solamente alla
        // Request appartenente al proprio Salon.

        allow create: if
        isSalon()
        &&
        get(
          /databases/$(database)/documents/appointment_requests/$(requestId)
        ).data.salonId
        == currentUser().data.salonId

        && request.resource.data.id == eventId
        && request.resource.data.requestId == requestId;


        // -----------------------------------------------------
        // CREATE - USER
        // -----------------------------------------------------

        // Il cliente può aggiungere esclusivamente l'evento
        // relativo alla propria risposta.
        //
        // getAfter() verifica lo stato della Request
        // dopo la transazione/batch ma prima del commit.

        allow create: if
        isUser()

        && get(
          /databases/$(database)/documents/appointment_requests/$(requestId)
        ).data.customerId
        == request.auth.uid

        && request.resource.data.id == eventId
        && request.resource.data.requestId == requestId

        && (
          (
            request.resource.data.type == "accepted"
            &&
            request.resource.data.author == "customer"
            &&
            getAfter(
              /databases/$(database)/documents/appointment_requests/$(requestId)
            ).data.status == "accepted"
          )
          ||
          (
            request.resource.data.type == "rejected"
            &&
            request.resource.data.author == "customer"
            &&
            getAfter(
              /databases/$(database)/documents/appointment_requests/$(requestId)
            ).data.status == "rejected"
          )
        );
      }
    }


    // =========================================================
    // EMPLOYEE CALENDAR
    // =========================================================

    match /employee_calendar/{eventId} {

      // -------------------------------------------------------
      // READ
      // -------------------------------------------------------

      // Il calendario appartiene al Salon.
      //
      // Employee non è un account.
      //
      // Il cliente può leggere il calendario perché necessario
      // al flusso di prenotazione.

      allow read: if
      signedIn()
      && (
        (
          isSalon()
          && resource.data.salonId
          == currentUser().data.salonId
        )
        ||
        isUser()
      );


      // -------------------------------------------------------
      // CREATE
      // -------------------------------------------------------

      allow create: if
      isSalon()
      && request.resource.data.salonId
      == currentUser().data.salonId;


      // -------------------------------------------------------
      // UPDATE
      // -------------------------------------------------------

      allow update: if
      isSalon()
      && resource.data.salonId
      == currentUser().data.salonId
      && request.resource.data.salonId
      == currentUser().data.salonId;


      // -------------------------------------------------------
      // DELETE
      // -------------------------------------------------------

      // IMPORTANTE:
      // durante delete request.resource non esiste.
      // Bisogna quindi controllare resource.

      allow delete: if
      isSalon()
      && resource.data.salonId
      == currentUser().data.salonId;
    }


    // =========================================================
    // DEFAULT DENY
    // =========================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}