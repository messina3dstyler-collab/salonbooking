rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // =========================================================
    // AUTH
    // =========================================================

    function signedIn() {
      return request.auth != null;
    }

    function userExists() {
      return signedIn()
      && exists(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function currentUser() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    // =========================================================
    // SALON
    // =========================================================
    //
    // Nell'app il ruolo del Salon è "admin".
    //
    // Employee NON è un utente autenticato.
    //
    // =========================================================

    function isSalon() {
      return userExists()
      && currentUser().data.role == "admin"
      && currentUser().data.salonId is string
      && currentUser().data.salonId != "";
    }

    function ownsSalon(salonId) {
      return isSalon()
      && currentUser().data.salonId == salonId;
    }

    // =========================================================
    // USER / CUSTOMER
    // =========================================================
    //
    // Nell'app il cliente finale è "customer".
    //
    // =========================================================

    function isUser() {
      return userExists()
      && currentUser().data.role == "customer";
    }

    function isOwnUser(userId) {
      return signedIn()
      && request.auth.uid == userId;
    }



    // =========================================================
    // APPOINTMENT / SLOT / AVAILABILITY HELPERS
    // =========================================================

    function appointmentRef(appointmentId) {
      return /databases/$(database)/documents/appointments/$(appointmentId);
    }

    function employeeRef(salonId, employeeId) {
      return /databases/$(database)/documents/salons/$(salonId)/employees/$(employeeId);
    }

    function serviceRef(salonId, serviceId) {
      return /databases/$(database)/documents/salons/$(salonId)/services/$(serviceId);
    }

    function slotRef(slotId) {
      return /databases/$(database)/documents/appointment_slots/$(slotId);
    }

    function validAppointmentData(data) {
      return
        data.userId is string
        && data.userId != ""
        && data.salonId is string
        && data.salonId != ""
        && data.employeeId is string
        && data.employeeId != ""
        && data.serviceId is string
        && data.serviceId != ""
        && data.date is timestamp
        && data.duration is int
        && data.duration > 0
        && data.duration <= 180
        && data.status is string
        && (
          data.status == "Prenotata"
          || data.status == "Confermata"
          || data.status == "Completata"
          || data.status == "Annullata"
        );
    }

    function appointmentReferencesMatch(data) {
      return
        exists(employeeRef(data.salonId, data.employeeId))
        && exists(serviceRef(data.salonId, data.serviceId))
        && get(serviceRef(data.salonId, data.serviceId)).data.duration is int
        && get(serviceRef(data.salonId, data.serviceId)).data.duration > 0
        && get(serviceRef(data.salonId, data.serviceId)).data.duration <= 180
        && data.duration == get(serviceRef(data.salonId, data.serviceId)).data.duration
        && data.serviceDuration == data.duration;
    }

    function validSlotData(data) {
      return
        data.appointmentId is string
        && data.appointmentId != ""
        && data.userId is string
        && data.userId != ""
        && data.salonId is string
        && data.salonId != ""
        && data.employeeId is string
        && data.employeeId != ""
        && data.start is timestamp;
    }


    // =========================================================
    // USERS
    // =========================================================

    match /users/{userId} {

      // -------------------------------------------------------
      // READ
      // -------------------------------------------------------

      allow read: if
      isOwnUser(userId)
      || isSalon();


      // -------------------------------------------------------
      // CREATE
      // -------------------------------------------------------

      allow create: if
      isOwnUser(userId)
      && request.resource.data.role == "customer"
      && request.resource.data.salonId == null;


      // -------------------------------------------------------
      // UPDATE
      // -------------------------------------------------------

      allow update: if
      isOwnUser(userId)
      && request.resource.data.role == resource.data.role
      && request.resource.data.salonId == resource.data.salonId
      && request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasOnly([
        "name",
        "email",
        "phone",
        "photoUrl"
      ]);


      // -------------------------------------------------------
      // DELETE
      // -------------------------------------------------------

      allow delete: if false;
    }


    // =========================================================
    // SALONS
    // =========================================================

    match /salons/{salonId} {

      allow read: if signedIn();


      // -------------------------------------------------------
      // CREATE
      // -------------------------------------------------------

      allow create: if false;


      // -------------------------------------------------------
      // UPDATE
      // -------------------------------------------------------

      allow update: if
        ownsSalon(salonId)
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "name",
            "address",
            "city",
            "imageUrl",
            "rating",
            "reviewCount",
            "phone",
            "description",
            "openingHour",
            "closingHour",
            "closedWeekdays",
            "closedDates",
            "active"
          ]);


      // -------------------------------------------------------
      // DELETE
      // -------------------------------------------------------

      allow delete: if ownsSalon(salonId);


      // =======================================================
      // EMPLOYEES
      // =======================================================

      match /employees/{employeeId} {

        allow read: if signedIn();

        allow create, update, delete: if
        ownsSalon(salonId);
      }


      // =======================================================
      // SERVICES
      // =======================================================

      match /services/{serviceId} {

        allow read: if signedIn();

        allow create: if
        ownsSalon(salonId)
        && request.resource.data.duration is int
        && request.resource.data.duration > 0
        && request.resource.data.duration <= 180;

        allow update: if
        ownsSalon(salonId)
        && request.resource.data.duration is int
        && request.resource.data.duration > 0
        && request.resource.data.duration <= 180;

        allow delete: if ownsSalon(salonId);
      }


      // =======================================================
      // REVIEWS
      // =======================================================

      match /reviews/{reviewId} {

        allow read: if signedIn();


        // -----------------------------------------------------
        // CREATE
        // -----------------------------------------------------

        allow create: if
        isUser()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.salonId == salonId;


        // -----------------------------------------------------
        // UPDATE / DELETE
        // -----------------------------------------------------

        allow update, delete: if
        ownsSalon(salonId);
      }


      // =======================================================
      // NESTED APPOINTMENTS
      // =======================================================

      match /appointments/{appointmentId} {

        // -----------------------------------------------------
        // READ
        // -----------------------------------------------------

        allow read: if
        signedIn()
        && (
          (
            isUser()
            && resource.data.userId == request.auth.uid
          )
          ||
          ownsSalon(salonId)
        );


        // -----------------------------------------------------
        // CREATE
        // -----------------------------------------------------

        allow create: if
        ownsSalon(salonId);


        // -----------------------------------------------------
        // UPDATE / DELETE
        // -----------------------------------------------------

        allow update, delete: if
        ownsSalon(salonId);
      }
    }



    // =========================================================
    // ROOT APPOINTMENTS
    // =========================================================

    match /appointments/{appointmentId} {

      // -------------------------------------------------------
      // READ
      // -------------------------------------------------------

      allow read: if
        signedIn()
        && (
          (
            isUser()
            && resource.data.userId == request.auth.uid
          )
          ||
          (
            isSalon()
            && resource.data.salonId == currentUser().data.salonId
          )
        );


      // -------------------------------------------------------
      // CREATE
      // -------------------------------------------------------

      allow create: if
        signedIn()
        && validAppointmentData(request.resource.data)
        && appointmentReferencesMatch(request.resource.data)
        && (
          (
            isUser()
            && request.resource.data.userId == request.auth.uid
          )
          ||
          (
            isSalon()
            && request.resource.data.salonId
               == currentUser().data.salonId
          )
        );


      // -------------------------------------------------------
      // UPDATE
      // -------------------------------------------------------

      allow update: if

        // =====================================================
        // SALON
        // =====================================================

        (
          isSalon()
          && resource.data.salonId
             == currentUser().data.salonId
          && request.resource.data.userId
             == resource.data.userId
          && request.resource.data.salonId
             == resource.data.salonId
          && validAppointmentData(request.resource.data)
          && request.resource.data.employeeId
             == resource.data.employeeId
          && request.resource.data.serviceId
             == resource.data.serviceId
          && request.resource.data.duration
             == resource.data.duration
          && request.resource.data.serviceDuration
             == resource.data.serviceDuration
        )

        ||

        // =====================================================
        // CUSTOMER - ACCEPT REQUEST
        // =====================================================

        (
          isUser()

          // ---------------------------------------------------
          // Appointment ownership
          // ---------------------------------------------------

          && resource.data.userId == request.auth.uid

          // ---------------------------------------------------
          // Appointment identity immutable
          // ---------------------------------------------------

          && request.resource.data.userId
             == resource.data.userId

          && request.resource.data.salonId
             == resource.data.salonId

          && validAppointmentData(request.resource.data)


          // ---------------------------------------------------
          // acceptedRequestId
          // ---------------------------------------------------

          && request.resource.data.acceptedRequestId is string

          && request.resource.data.acceptedRequestId != ""

          && request.resource.data.acceptedRequestId
             != resource.data.acceptedRequestId

          // ---------------------------------------------------
          // Request must be accepted in the same transaction.
          // ---------------------------------------------------

          && getAfter(
            /databases/$(database)/documents/appointment_requests/$(request.resource.data.acceptedRequestId)
          ).data.status == "accepted"

          && getAfter(
            /databases/$(database)/documents/appointment_requests/$(request.resource.data.acceptedRequestId)
          ).data.customerId == request.auth.uid

          && getAfter(
            /databases/$(database)/documents/appointment_requests/$(request.resource.data.acceptedRequestId)
          ).data.appointmentId == appointmentId

          && getAfter(
            /databases/$(database)/documents/appointment_requests/$(request.resource.data.acceptedRequestId)
          ).data.salonId == resource.data.salonId

          // ---------------------------------------------------
          // Request type -> Appointment fields
          // ---------------------------------------------------

          && (
            // -------------------------------------------------
            // RESCHEDULE
            // -------------------------------------------------

            (
              getAfter(
                /databases/$(database)/documents/appointment_requests/$(request.resource.data.acceptedRequestId)
              ).data.type == "reschedule"

              && getAfter(
                /databases/$(database)/documents/appointment_requests/$(request.resource.data.acceptedRequestId)
              ).data.payload.newStart is string

              && getAfter(
                /databases/$(database)/documents/appointment_requests/$(request.resource.data.acceptedRequestId)
              ).data.payload.newStart != ""

              && request.resource.data.diff(resource.data)
                .affectedKeys()
                .hasOnly([
                  "date",
                  "acceptedRequestId"
                ])

              && request.resource.data.date
                 != resource.data.date
            )

            ||

            // -------------------------------------------------
            // CHANGE EMPLOYEE
            // -------------------------------------------------

            (
              getAfter(
                /databases/$(database)/documents/appointment_requests/$(request.resource.data.acceptedRequestId)
              ).data.type == "changeEmployee"

              && (
                (
                  getAfter(
                    /databases/$(database)/documents/appointment_requests/$(request.resource.data.acceptedRequestId)
                  ).data.payload.newEmployeeId is string

                  && getAfter(
                    /databases/$(database)/documents/appointment_requests/$(request.resource.data.acceptedRequestId)
                  ).data.payload.newEmployeeId != ""

                  && request.resource.data.employeeId
                     ==
                     getAfter(
                       /databases/$(database)/documents/appointment_requests/$(request.resource.data.acceptedRequestId)
                     ).data.payload.newEmployeeId
                )

                ||

                (
                  getAfter(
                    /databases/$(database)/documents/appointment_requests/$(request.resource.data.acceptedRequestId)
                  ).data.payload.newEmployee is string

                  && getAfter(
                    /databases/$(database)/documents/appointment_requests/$(request.resource.data.acceptedRequestId)
                  ).data.payload.newEmployee != ""

                  && request.resource.data.employeeId
                     ==
                     getAfter(
                       /databases/$(database)/documents/appointment_requests/$(request.resource.data.acceptedRequestId)
                     ).data.payload.newEmployee
                )
              )

              && exists(
                employeeRef(
                  resource.data.salonId,
                  request.resource.data.employeeId
                )
              )

              && request.resource.data.diff(resource.data)
                .affectedKeys()
                .hasOnly([
                  "employeeId",
                  "employeeName",
                  "employeePhone",
                  "employeeSpecialization",
                  "employeeRating",
                  "acceptedRequestId"
                ])
            )

            ||

            // -------------------------------------------------
            // CHANGE SERVICES
            // -------------------------------------------------

            (
              getAfter(
                /databases/$(database)/documents/appointment_requests/$(request.resource.data.acceptedRequestId)
              ).data.type == "changeServices"

              && (
                (
                  getAfter(
                    /databases/$(database)/documents/appointment_requests/$(request.resource.data.acceptedRequestId)
                  ).data.payload.newServiceIds is list

                  && getAfter(
                    /databases/$(database)/documents/appointment_requests/$(request.resource.data.acceptedRequestId)
                  ).data.payload.newServiceIds.size() == 1

                  && request.resource.data.serviceId
                     ==
                     getAfter(
                       /databases/$(database)/documents/appointment_requests/$(request.resource.data.acceptedRequestId)
                     ).data.payload.newServiceIds[0]
                )
              )

              && exists(
                serviceRef(
                  resource.data.salonId,
                  request.resource.data.serviceId
                )
              )

              && get(
                serviceRef(
                  resource.data.salonId,
                  request.resource.data.serviceId
                )
              ).data.duration is int

              && get(
                serviceRef(
                  resource.data.salonId,
                  request.resource.data.serviceId
                )
              ).data.duration > 0

              && get(
                serviceRef(
                  resource.data.salonId,
                  request.resource.data.serviceId
                )
              ).data.duration <= 180

              && request.resource.data.duration is int
              && request.resource.data.duration > 0
              && request.resource.data.duration <= 180

              && request.resource.data.serviceDuration
                 == request.resource.data.duration

              && request.resource.data.duration
                 ==
                 get(
                   serviceRef(
                     resource.data.salonId,
                     request.resource.data.serviceId
                   )
                 ).data.duration

              && request.resource.data.price is number
              && request.resource.data.price >= 0

              && getAfter(
                /databases/$(database)/documents/appointment_requests/$(request.resource.data.acceptedRequestId)
              ).data.payload.newDuration is int

              && getAfter(
                /databases/$(database)/documents/appointment_requests/$(request.resource.data.acceptedRequestId)
              ).data.payload.newDuration == request.resource.data.duration

              && getAfter(
                /databases/$(database)/documents/appointment_requests/$(request.resource.data.acceptedRequestId)
              ).data.payload.newTotalPrice is number

              && getAfter(
                /databases/$(database)/documents/appointment_requests/$(request.resource.data.acceptedRequestId)
              ).data.payload.newTotalPrice == request.resource.data.price

              && request.resource.data.diff(resource.data)
                .affectedKeys()
                .hasOnly([
                  "serviceId",
                  "serviceName",
                  "serviceDuration",
                  "duration",
                  "price",
                  "acceptedRequestId"
                ])
            )

            ||

            // -------------------------------------------------
            // CANCEL APPOINTMENT
            // -------------------------------------------------

            (
              getAfter(
                /databases/$(database)/documents/appointment_requests/$(request.resource.data.acceptedRequestId)
              ).data.type == "cancelAppointment"

              && request.resource.data.status == "Annullata"

              && request.resource.data.diff(resource.data)
                .affectedKeys()
                .hasOnly([
                  "status",
                  "acceptedRequestId"
                ])
            )

            ||

            // -------------------------------------------------
            // CUSTOM
            // -------------------------------------------------

            (
              getAfter(
                /databases/$(database)/documents/appointment_requests/$(request.resource.data.acceptedRequestId)
              ).data.type == "custom"

              && request.resource.data.diff(resource.data)
                .affectedKeys()
                .hasOnly([
                  "acceptedRequestId"
                ])
            )
          )
        );


      // -------------------------------------------------------
      // DELETE
      // -------------------------------------------------------

      allow delete: if
        isSalon()
        && resource.data.salonId
           == currentUser().data.salonId;
    }


    // =========================================================
    // APPOINTMENT SLOTS
    // =========================================================

    match /appointment_slots/{slotId} {

      // -------------------------------------------------------
      // READ
      // -------------------------------------------------------

      // Slots are private technical locks.
      // Customers must never read them.
      allow read: if
        isSalon()
        && resource.data.salonId
           == currentUser().data.salonId;


      // -------------------------------------------------------
      // CREATE
      // -------------------------------------------------------

      allow create: if
        signedIn()
        && validSlotData(request.resource.data)

        && getAfter(
          appointmentRef(request.resource.data.appointmentId)
        ).data.userId
           == request.resource.data.userId

        && getAfter(
          appointmentRef(request.resource.data.appointmentId)
        ).data.salonId
           == request.resource.data.salonId

        && getAfter(
          appointmentRef(request.resource.data.appointmentId)
        ).data.employeeId
           == request.resource.data.employeeId

        && request.resource.data.start
           >= getAfter(
                appointmentRef(request.resource.data.appointmentId)
              ).data.date

        && request.resource.data.start
           < getAfter(
                appointmentRef(request.resource.data.appointmentId)
              ).data.date
              + duration.value(
                  getAfter(
                    appointmentRef(
                      request.resource.data.appointmentId
                    )
                  ).data.duration,
                  'm'
                )

        && (
          (
            isSalon()
            && request.resource.data.salonId
               == currentUser().data.salonId
          )
          ||
          (
            isUser()
            && request.resource.data.userId
               == request.auth.uid
            && (
              !exists(
                appointmentRef(
                  request.resource.data.appointmentId
                )
              )
              ||
              getAfter(
                appointmentRef(
                  request.resource.data.appointmentId
                )
              ).data.acceptedRequestId
              != get(
                appointmentRef(
                  request.resource.data.appointmentId
                )
              ).data.acceptedRequestId
            )
          )
        );


      // -------------------------------------------------------
      // UPDATE
      // -------------------------------------------------------

      allow update: if
        validSlotData(request.resource.data)

        && getAfter(
          appointmentRef(request.resource.data.appointmentId)
        ).data.userId
           == request.resource.data.userId

        && getAfter(
          appointmentRef(request.resource.data.appointmentId)
        ).data.salonId
           == request.resource.data.salonId

        && getAfter(
          appointmentRef(request.resource.data.appointmentId)
        ).data.employeeId
           == request.resource.data.employeeId

        && request.resource.data.start
           >= getAfter(
                appointmentRef(request.resource.data.appointmentId)
              ).data.date

        && (
          (
            isSalon()
            && request.resource.data.salonId
               == currentUser().data.salonId
          )
          ||
          (
            isUser()
            && request.resource.data.userId
               == request.auth.uid
            && getAfter(
                 appointmentRef(
                   request.resource.data.appointmentId
                 )
               ).data.acceptedRequestId
               != get(
                 appointmentRef(
                   request.resource.data.appointmentId
                 )
               ).data.acceptedRequestId
          )
        );


      // -------------------------------------------------------
      // DELETE
      // -------------------------------------------------------

      allow delete: if
        (
          isSalon()
          && resource.data.salonId
             == currentUser().data.salonId
        )
        ||
        (
          isUser()
          && resource.data.userId
             == request.auth.uid
          && (
            !exists(
              appointmentRef(resource.data.appointmentId)
            )
            ||
            getAfter(
              appointmentRef(resource.data.appointmentId)
            ).data.status == "Annullata"
            ||
            (
              getAfter(
                appointmentRef(resource.data.appointmentId)
              ).data.acceptedRequestId is string
              && getAfter(
                appointmentRef(resource.data.appointmentId)
              ).data.acceptedRequestId != ""
            )
          )
        );
    }


    // =========================================================
    // APPOINTMENT AVAILABILITY
    // =========================================================

    match /appointment_availability/{availabilityId} {

      // -------------------------------------------------------
      // READ
      // -------------------------------------------------------

      // This collection is the privacy-safe customer projection.
      allow read: if
        isUser()
        || (
          isSalon()
          && resource.data.salonId
             == currentUser().data.salonId
        );


      // -------------------------------------------------------
      // CREATE
      // -------------------------------------------------------

      allow create: if
        signedIn()
        && request.resource.data.salonId is string
        && request.resource.data.salonId != ""
        && request.resource.data.employeeId is string
        && request.resource.data.employeeId != ""
        && request.resource.data.start is timestamp

        && existsAfter(
          slotRef(availabilityId)
        )

        && getAfter(
          slotRef(availabilityId)
        ).data.salonId
           == request.resource.data.salonId

        && getAfter(
          slotRef(availabilityId)
        ).data.employeeId
           == request.resource.data.employeeId

        && getAfter(
          slotRef(availabilityId)
        ).data.start
           == request.resource.data.start

        && (
          isSalon()
          || (
            isUser()
            && getAfter(
              slotRef(availabilityId)
            ).data.userId == request.auth.uid
          )
        );


      // -------------------------------------------------------
      // UPDATE
      // -------------------------------------------------------

      allow update: if
        request.resource.data.salonId is string
        && request.resource.data.employeeId is string
        && request.resource.data.start is timestamp

        && existsAfter(
          slotRef(availabilityId)
        )

        && getAfter(
          slotRef(availabilityId)
        ).data.salonId
           == request.resource.data.salonId

        && getAfter(
          slotRef(availabilityId)
        ).data.employeeId
           == request.resource.data.employeeId

        && getAfter(
          slotRef(availabilityId)
        ).data.start
           == request.resource.data.start

        && (
          isSalon()
          || (
            isUser()
            && getAfter(
              slotRef(availabilityId)
            ).data.userId == request.auth.uid
            && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                "salonId",
                "employeeId",
                "start"
              ])
          )
        );


      // -------------------------------------------------------
      // DELETE
      // -------------------------------------------------------

      allow delete: if
        (
          isSalon()
          && resource.data.salonId
             == currentUser().data.salonId
        )
        ||
        (
          isUser()
          && !existsAfter(
            slotRef(availabilityId)
          )
          && get(
            slotRef(availabilityId)
          ).data.userId == request.auth.uid
        );
    }


    // =========================================================
    // APPOINTMENT REQUESTS
    // =========================================================

    match /appointment_requests/{requestId} {

      // -------------------------------------------------------
      // READ
      // -------------------------------------------------------

      allow read: if
      signedIn()
      && (
        (
          isSalon()
          && resource.data.salonId
          == currentUser().data.salonId
        )
        ||
        (
          isUser()
          && resource.data.customerId
          == request.auth.uid
        )
      );


      // -------------------------------------------------------
      // CREATE
      // -------------------------------------------------------

      allow create: if
      isSalon()
      && request.resource.data.id == requestId
      && request.resource.data.salonId
      == currentUser().data.salonId
      && request.resource.data.customerId is string
      && request.resource.data.customerId != ""
      && request.resource.data.appointmentId is string
      && request.resource.data.appointmentId != ""
      && request.resource.data.createdBy == "admin"
      && request.resource.data.status == "draft"
      && request.resource.data.type is string
      && request.resource.data.priority is string
      && request.resource.data.payload is map;


      // -------------------------------------------------------
      // UPDATE
      // -------------------------------------------------------

      allow update: if

      // =======================================================
      // SALON
      // =======================================================

      (
        isSalon()

        && resource.data.salonId
        == currentUser().data.salonId

        && request.resource.data.salonId
        == resource.data.salonId

        && request.resource.data.customerId
        == resource.data.customerId

        && request.resource.data.appointmentId
        == resource.data.appointmentId

        && request.resource.data.createdBy
        == resource.data.createdBy

        && request.resource.data.type
        == resource.data.type

        && request.resource.data.priority
        == resource.data.priority

        && request.resource.data.payload
        == resource.data.payload

        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
          "status",
          "updatedAt"
        ])

        && (
          (
            resource.data.status == "draft"
            && request.resource.data.status
            == "pendingCustomer"
          )
          ||
          (
            resource.data.status == "pendingCustomer"
            && (
              request.resource.data.status == "cancelled"
              || request.resource.data.status == "expired"
            )
          )
        )
      )

      ||

      // =======================================================
      // CUSTOMER
      // =======================================================
      //
      // Il customer può solamente:
      //
      // pendingCustomer -> accepted
      // pendingCustomer -> rejected
      //
      // Per accepted:
      //
      // la stessa transaction deve modificare anche
      // l'Appointment.
      //
      // =======================================================

      (
        isUser()

        && resource.data.customerId
        == request.auth.uid

        && request.resource.data.salonId
        == resource.data.salonId

        && request.resource.data.customerId
        == resource.data.customerId

        && request.resource.data.appointmentId
        == resource.data.appointmentId

        && request.resource.data.createdBy
        == resource.data.createdBy

        && request.resource.data.type
        == resource.data.type

        && request.resource.data.priority
        == resource.data.priority

        && request.resource.data.payload
        == resource.data.payload

        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
          "status",
          "updatedAt"
        ])

        && resource.data.status == "pendingCustomer"

        && (
          // ---------------------------------------------------
          // REJECTED
          // ---------------------------------------------------

          (
            request.resource.data.status == "rejected"
          )

          ||

          // ---------------------------------------------------
          // ACCEPTED
          // ---------------------------------------------------

          (
            request.resource.data.status == "accepted"

            // -------------------------------------------------
            // Appointment must be updated in the same
            // atomic operation.
            // -------------------------------------------------

            && getAfter(
              /databases/$(database)/documents/appointments/$(resource.data.appointmentId)
            ).data.userId == request.auth.uid

            && getAfter(
              /databases/$(database)/documents/appointments/$(resource.data.appointmentId)
            ).data.acceptedRequestId == requestId

            && getAfter(
              /databases/$(database)/documents/appointments/$(resource.data.appointmentId)
            ).data.salonId == resource.data.salonId

            // -------------------------------------------------
            // Appointment update must match Request type.
            // -------------------------------------------------

            && (
              // -----------------------------------------------
              // RESCHEDULE
              // -----------------------------------------------

              (
                resource.data.type == "reschedule"

                && resource.data.payload.newStart is string

                && resource.data.payload.newStart != ""

                && getAfter(
                  /databases/$(database)/documents/appointments/$(resource.data.appointmentId)
                ).data.acceptedRequestId == requestId

                && getAfter(
                  /databases/$(database)/documents/appointments/$(resource.data.appointmentId)
                ).data.date
                != get(
                  /databases/$(database)/documents/appointments/$(resource.data.appointmentId)
                ).data.date
              )

              ||

              // -----------------------------------------------
              // CHANGE EMPLOYEE
              // -----------------------------------------------

              (
                resource.data.type == "changeEmployee"

                && (
                  (
                    resource.data.payload.newEmployeeId is string
                    && resource.data.payload.newEmployeeId != ""
                    && getAfter(
                      /databases/$(database)/documents/appointments/$(resource.data.appointmentId)
                    ).data.employeeId
                    == resource.data.payload.newEmployeeId
                  )

                  ||

                  (
                    resource.data.payload.newEmployee is string
                    && resource.data.payload.newEmployee != ""
                    && getAfter(
                      /databases/$(database)/documents/appointments/$(resource.data.appointmentId)
                    ).data.employeeId
                    == resource.data.payload.newEmployee
                  )
                )
              )

              ||

              // -----------------------------------------------
              // CHANGE SERVICES
              // -----------------------------------------------

              (
                resource.data.type == "changeServices"

                && (
                  (
                    resource.data.payload.newServiceId is string
                    && resource.data.payload.newServiceId != ""
                    && getAfter(
                      /databases/$(database)/documents/appointments/$(resource.data.appointmentId)
                    ).data.serviceId
                    == resource.data.payload.newServiceId
                  )

                  ||

                  (
                    resource.data.payload.serviceId is string
                    && resource.data.payload.serviceId != ""
                    && getAfter(
                      /databases/$(database)/documents/appointments/$(resource.data.appointmentId)
                    ).data.serviceId
                    == resource.data.payload.serviceId
                  )
                )
              )

              ||

              // -----------------------------------------------
              // CANCEL APPOINTMENT
              // -----------------------------------------------

              (
                resource.data.type == "cancelAppointment"

                && getAfter(
                  /databases/$(database)/documents/appointments/$(resource.data.appointmentId)
                ).data.status == "Annullata"
              )

              ||

              // -----------------------------------------------
              // CUSTOM
              // -----------------------------------------------

              (
                resource.data.type == "custom"

                && getAfter(
                  /databases/$(database)/documents/appointments/$(resource.data.appointmentId)
                ).data.acceptedRequestId == requestId
              )
            )
          )
        )
      );


      // -------------------------------------------------------
      // DELETE
      // -------------------------------------------------------

      allow delete: if false;


      // =======================================================
      // REQUEST TIMELINE
      // =======================================================

      match /timeline/{eventId} {

        // -----------------------------------------------------
        // READ
        // -----------------------------------------------------

        allow read: if
        signedIn()
        && (
          (
            isSalon()
            &&
            get(
              /databases/$(database)/documents/appointment_requests/$(requestId)
            ).data.salonId
            == currentUser().data.salonId
          )
          ||
          (
            isUser()
            &&
            get(
              /databases/$(database)/documents/appointment_requests/$(requestId)
            ).data.customerId
            == request.auth.uid
          )
        );


        // -----------------------------------------------------
        // UPDATE / DELETE
        // -----------------------------------------------------

        allow update, delete: if false;


        // -----------------------------------------------------
        // CREATE - SALON
        // -----------------------------------------------------

        allow create: if
        isSalon()
        &&
        get(
          /databases/$(database)/documents/appointment_requests/$(requestId)
        ).data.salonId
        == currentUser().data.salonId

        && request.resource.data.id == eventId
        && request.resource.data.requestId == requestId;


        // -----------------------------------------------------
        // CREATE - USER
        // -----------------------------------------------------
        //
        // Il customer può creare eventi solamente nella stessa
        // transaction in cui risponde alla Request.
        //
        // -----------------------------------------------------

        allow create: if
        isUser()

        && get(
          /databases/$(database)/documents/appointment_requests/$(requestId)
        ).data.customerId
        == request.auth.uid

        && request.resource.data.id == eventId
        && request.resource.data.requestId == requestId

        && (
          // ---------------------------------------------------
          // ACCEPTED
          // ---------------------------------------------------

          (
            request.resource.data.type == "accepted"

            && request.resource.data.author == "customer"

            && getAfter(
              /databases/$(database)/documents/appointment_requests/$(requestId)
            ).data.status == "accepted"

            && getAfter(
              /databases/$(database)/documents/appointments/$(getAfter(
                /databases/$(database)/documents/appointment_requests/$(requestId)
              ).data.appointmentId)
            ).data.acceptedRequestId == requestId
          )

          ||

          // ---------------------------------------------------
          // REJECTED
          // ---------------------------------------------------

          (
            request.resource.data.type == "rejected"

            && request.resource.data.author == "customer"

            && getAfter(
              /databases/$(database)/documents/appointment_requests/$(requestId)
            ).data.status == "rejected"
          )

          ||

          // ---------------------------------------------------
          // APPOINTMENT UPDATED
          // ---------------------------------------------------
          //
          // Questo evento viene creato da AcceptRequestOperation.
          //
          // Il suo author è "system".
          //
          // ---------------------------------------------------

          (
            request.resource.data.type == "appointmentUpdated"

            && request.resource.data.author == "system"

            && getAfter(
              /databases/$(database)/documents/appointment_requests/$(requestId)
            ).data.status == "accepted"

            && getAfter(
              /databases/$(database)/documents/appointments/$(getAfter(
                /databases/$(database)/documents/appointment_requests/$(requestId)
              ).data.appointmentId)
            ).data.acceptedRequestId == requestId
          )
        );
      }
    }


    // =========================================================
    // EMPLOYEE CALENDAR
    // =========================================================

    match /employee_calendar/{eventId} {

      // -------------------------------------------------------
      // READ
      // -------------------------------------------------------

      allow read: if
      signedIn()
      && (
        (
          isSalon()
          && resource.data.salonId
          == currentUser().data.salonId
        )
        ||
        isUser()
      );


      // -------------------------------------------------------
      // CREATE
      // -------------------------------------------------------

      allow create: if
      isSalon()
      && request.resource.data.salonId
      == currentUser().data.salonId;


      // -------------------------------------------------------
      // UPDATE
      // -------------------------------------------------------

      allow update: if
      isSalon()
      && resource.data.salonId
      == currentUser().data.salonId
      && request.resource.data.salonId
      == currentUser().data.salonId;


      // -------------------------------------------------------
      // DELETE
      // -------------------------------------------------------

      allow delete: if
      isSalon()
      && resource.data.salonId
      == currentUser().data.salonId;
    }


    // =========================================================
    // DEFAULT DENY
    // =========================================================

    match /salon_private/{salonId} {
      allow read: if ownsSalon(salonId);
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}