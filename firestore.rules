rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // USERS
    // =========================

    match /users/{userId} {

      // Il proprietario può leggere il proprio profilo
      // Gli admin possono leggere tutti i profili
      allow read: if request.auth != null &&
        (
          request.auth.uid == userId ||

          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
        );

      allow create: if request.auth != null &&
        request.auth.uid == userId;

      allow update: if request.auth != null &&
        request.auth.uid == userId;

      allow delete: if false;
    }

    // =========================
    // ROOT APPOINTMENTS
    // =========================

    match /appointments/{appointmentId} {

      allow read: if request.auth != null;

      allow create: if request.auth != null;

      allow update, delete: if request.auth != null &&
        (
          resource.data.userId == request.auth.uid ||

          (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin" &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.salonId == resource.data.salonId
          )
        );
    }

    // =========================
    // SALONS
    // =========================

    match /salons/{salonId} {

      // Chiunque autenticato può leggere i dati del salone
      allow read: if request.auth != null;

      // Solo admin del salone può modificarlo
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin" &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.salonId == salonId;

      // =========================
      // APPOINTMENTS
      // =========================

      match /appointments/{appointmentId} {

        allow read: if request.auth != null &&
        (
          resource.data.userId == request.auth.uid ||

          (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin" &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.salonId == salonId
          )
        );

        allow create,update,delete: if request.auth != null &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin" &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.salonId == salonId;
      }

      // =========================
      // EMPLOYEES
      // =========================

      match /employees/{employeeId} {

        allow read: if request.auth != null;

        allow write: if request.auth != null &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin" &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.salonId == salonId;
      }

      // =========================
      // SERVICES
      // =========================

      match /services/{serviceId} {

        allow read: if request.auth != null;

        allow write: if request.auth != null &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin" &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.salonId == salonId;
      }

      // =========================
      // REVIEWS
      // =========================

      match /reviews/{reviewId} {

        allow read: if request.auth != null;

        allow create: if request.auth != null;

        allow update,delete: if request.auth != null &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin" &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.salonId == salonId;
      }
    }
        // =========================
        // EMPLOYEE CALENDAR
        // =========================

        match /employee_calendar/{eventId} {

          allow read: if request.auth != null;

          allow create, update, delete: if request.auth != null &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";

        }
  }
}