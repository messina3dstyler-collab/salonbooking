rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // =========================================================
    // AUTH
    // =========================================================

    function signedIn() {
      return request.auth != null;
    }

    function userExists() {
      return signedIn()
      && exists(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function currentUser() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    // =========================================================
    // SALON
    // =========================================================
    //
    // Nell'app il ruolo del Salon è "admin".
    //
    // Employee NON è un utente autenticato.
    //
    // =========================================================

    function isSalon() {
      return userExists()
      && currentUser().data.role == "admin"
      && currentUser().data.salonId is string
      && currentUser().data.salonId != "";
    }

    function ownsSalon(salonId) {
      return isSalon()
      && currentUser().data.salonId == salonId;
    }

    // =========================================================
    // USER / CUSTOMER
    // =========================================================
    //
    // Nell'app il cliente finale è "customer".
    //
    // =========================================================

    function isUser() {
      return userExists()
      && currentUser().data.role == "customer";
    }

    function isOwnUser(userId) {
      return signedIn()
      && request.auth.uid == userId;
    }


    // =========================================================
    // USERS
    // =========================================================

    match /users/{userId} {

      // -------------------------------------------------------
      // READ
      // -------------------------------------------------------

      allow read: if
      isOwnUser(userId)
      || isSalon();


      // -------------------------------------------------------
      // CREATE
      // -------------------------------------------------------

      allow create: if
      isOwnUser(userId)
      && request.resource.data.role is string
      && (
        request.resource.data.role == "admin"
        || request.resource.data.role == "customer"
      );


      // -------------------------------------------------------
      // UPDATE
      // -------------------------------------------------------

      allow update: if
      isOwnUser(userId)
      && request.resource.data.role == resource.data.role
      && request.resource.data.salonId == resource.data.salonId
      && request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasOnly([
        "name",
        "email",
        "phone",
        "photoUrl"
      ]);


      // -------------------------------------------------------
      // DELETE
      // -------------------------------------------------------

      allow delete: if false;
    }


    // =========================================================
    // SALONS
    // =========================================================

    match /salons/{salonId} {

      allow read: if signedIn();


      // -------------------------------------------------------
      // CREATE
      // -------------------------------------------------------

      allow create: if
      signedIn()
      && request.auth.uid == salonId;


      // -------------------------------------------------------
      // UPDATE
      // -------------------------------------------------------

      allow update: if
      ownsSalon(salonId)
      && request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasOnly([
        "name",
        "address",
        "city",
        "imageUrl",
        "rating",
        "reviewCount",
        "phone",
        "description",
        "openingHour",
        "closingHour",
        "closedWeekdays",
        "closedDates",
        "active",
        "taxIdType",
        "taxId"
      ]);


      // -------------------------------------------------------
      // DELETE
      // -------------------------------------------------------

      allow delete: if ownsSalon(salonId);


      // =======================================================
      // EMPLOYEES
      // =======================================================

      match /employees/{employeeId} {

        allow read: if signedIn();

        allow create, update, delete: if
        ownsSalon(salonId);
      }


      // =======================================================
      // SERVICES
      // =======================================================

      match /services/{serviceId} {

        allow read: if signedIn();

        allow create, update, delete: if
        ownsSalon(salonId);
      }


      // =======================================================
      // REVIEWS
      // =======================================================

      match /reviews/{reviewId} {

        allow read: if signedIn();


        // -----------------------------------------------------
        // CREATE
        // -----------------------------------------------------

        allow create: if
        isUser()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.salonId == salonId;


        // -----------------------------------------------------
        // UPDATE / DELETE
        // -----------------------------------------------------

        allow update, delete: if
        ownsSalon(salonId);
      }


      // =======================================================
      // NESTED APPOINTMENTS
      // =======================================================

      match /appointments/{appointmentId} {

        // -----------------------------------------------------
        // READ
        // -----------------------------------------------------

        allow read: if
        signedIn()
        && (
          (
            isUser()
            && resource.data.userId == request.auth.uid
          )
          ||
          ownsSalon(salonId)
        );


        // -----------------------------------------------------
        // CREATE
        // -----------------------------------------------------

        allow create: if
        ownsSalon(salonId);


        // -----------------------------------------------------
        // UPDATE / DELETE
        // -----------------------------------------------------

        allow update, delete: if
        ownsSalon(salonId);
      }
    }


    // =========================================================
    // ROOT APPOINTMENTS
    // =========================================================

    match /appointments/{appointmentId} {

      // -------------------------------------------------------
      // READ
      // -------------------------------------------------------

      allow read: if
      signedIn()
      && (
        (
          isUser()
          && resource.data.userId == request.auth.uid
        )
        ||
        (
          isSalon()
          && resource.data.salonId == currentUser().data.salonId
        )
      );


      // -------------------------------------------------------
      // CREATE
      // -------------------------------------------------------

      allow create: if
      signedIn()
      && (
        (
          isUser()
          && request.resource.data.userId == request.auth.uid
        )
        ||
        (
          isSalon()
          && request.resource.data.salonId
          == currentUser().data.salonId
        )
      );


      // -------------------------------------------------------
      // UPDATE
      // -------------------------------------------------------
      //
      // Il Salon può modificare gli appuntamenti del proprio
      // salone.
      //
      // Il customer invece può modificare un Appointment
      // solamente come parte dell'accettazione di una Request.
      //
      // =======================================================

      allow update: if

      // =======================================================
      // SALON
      // =======================================================

      (
        isSalon()
        && resource.data.salonId
        == currentUser().data.salonId
      )

      ||

      // =======================================================
      // CUSTOMER - ACCEPT REQUEST
      // =======================================================
      //
      // Il customer NON può modificare liberamente
      // l'Appointment.
      //
      // L'update deve essere parte della stessa transaction
      // che porta la Request:
      //
      // pendingCustomer -> accepted
      //
      // e collega:
      //
      // Appointment.acceptedRequestId == Request.id
      //
      // =======================================================

      (
        isUser()

        // -----------------------------------------------------
        // Appointment ownership
        // -----------------------------------------------------

        && resource.data.userId == request.auth.uid

        // -----------------------------------------------------
        // Appointment identity immutable
        // -----------------------------------------------------

        && request.resource.data.userId
        == resource.data.userId

        && request.resource.data.salonId
        == resource.data.salonId

        // -----------------------------------------------------
        // acceptedRequestId
        //
        // Deve essere valorizzato con una Request reale.
        // -----------------------------------------------------

        && request.resource.data.acceptedRequestId is string

        && request.resource.data.acceptedRequestId != ""

        // -----------------------------------------------------
        // La Request collegata deve essere la Request che
        // viene accettata nella stessa operazione atomica.
        // -----------------------------------------------------

        && getAfter(
          /databases/$(database)/documents/appointment_requests/$(request.resource.data.acceptedRequestId)
        ).data.status == "accepted"

        // -----------------------------------------------------
        // Request -> customer
        // -----------------------------------------------------

        && getAfter(
          /databases/$(database)/documents/appointment_requests/$(request.resource.data.acceptedRequestId)
        ).data.customerId == request.auth.uid

        // -----------------------------------------------------
        // Request -> Appointment
        // -----------------------------------------------------

        && getAfter(
          /databases/$(database)/documents/appointment_requests/$(request.resource.data.acceptedRequestId)
        ).data.appointmentId == appointmentId

        // -----------------------------------------------------
        // Request -> Salon
        // -----------------------------------------------------

        && getAfter(
          /databases/$(database)/documents/appointment_requests/$(request.resource.data.acceptedRequestId)
        ).data.salonId == resource.data.salonId

        // -----------------------------------------------------
        // acceptedRequestId deve realmente cambiare.
        // -----------------------------------------------------

        && request.resource.data.acceptedRequestId
        != resource.data.acceptedRequestId

        // -----------------------------------------------------
        // Request type -> Appointment fields
        // -----------------------------------------------------

        && (
          // ---------------------------------------------------
          // RESCHEDULE
          // ---------------------------------------------------

          (
            getAfter(
              /databases/$(database)/documents/appointment_requests/$(request.resource.data.acceptedRequestId)
            ).data.type == "reschedule"

            && getAfter(
              /databases/$(database)/documents/appointment_requests/$(request.resource.data.acceptedRequestId)
            ).data.payload.newStart is string

            && getAfter(
              /databases/$(database)/documents/appointment_requests/$(request.resource.data.acceptedRequestId)
            ).data.payload.newStart != ""

            && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
              "date",
              "acceptedRequestId"
            ])

            // La data deve effettivamente cambiare.
            //
            // Firestore Rules non possono eseguire DateTime.parse()
            // sul valore stringa della payload.
            //
            // Per questo verifichiamo che:
            // - il payload contenga newStart;
            // - date sia tra i campi modificati;
            // - acceptedRequestId sia quello della Request.
            //
            // La conversione stringa -> Timestamp viene eseguita
            // dal Dart service prima della write.

            && request.resource.data.date
            != resource.data.date
          )

          ||

          // ---------------------------------------------------
          // CHANGE EMPLOYEE
          // ---------------------------------------------------

          (
            getAfter(
              /databases/$(database)/documents/appointment_requests/$(request.resource.data.acceptedRequestId)
            ).data.type == "changeEmployee"

            && (
              (
                getAfter(
                  /databases/$(database)/documents/appointment_requests/$(request.resource.data.acceptedRequestId)
                ).data.payload.newEmployeeId is string

                && getAfter(
                  /databases/$(database)/documents/appointment_requests/$(request.resource.data.acceptedRequestId)
                ).data.payload.newEmployeeId != ""

                && request.resource.data.employeeId
                ==
                getAfter(
                  /databases/$(database)/documents/appointment_requests/$(request.resource.data.acceptedRequestId)
                ).data.payload.newEmployeeId
              )

              ||

              (
                getAfter(
                  /databases/$(database)/documents/appointment_requests/$(request.resource.data.acceptedRequestId)
                ).data.payload.newEmployee is string

                && getAfter(
                  /databases/$(database)/documents/appointment_requests/$(request.resource.data.acceptedRequestId)
                ).data.payload.newEmployee != ""

                && request.resource.data.employeeId
                ==
                getAfter(
                  /databases/$(database)/documents/appointment_requests/$(request.resource.data.acceptedRequestId)
                ).data.payload.newEmployee
              )
            )

            && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
              "employeeId",
              "acceptedRequestId"
            ])
          )

          ||

          // ---------------------------------------------------
          // CHANGE SERVICES
          // ---------------------------------------------------

          (
            getAfter(
              /databases/$(database)/documents/appointment_requests/$(request.resource.data.acceptedRequestId)
            ).data.type == "changeServices"

            && (
              (
                getAfter(
                  /databases/$(database)/documents/appointment_requests/$(request.resource.data.acceptedRequestId)
                ).data.payload.newServiceId is string

                && getAfter(
                  /databases/$(database)/documents/appointment_requests/$(request.resource.data.acceptedRequestId)
                ).data.payload.newServiceId != ""

                && request.resource.data.serviceId
                ==
                getAfter(
                  /databases/$(database)/documents/appointment_requests/$(request.resource.data.acceptedRequestId)
                ).data.payload.newServiceId
              )

              ||

              (
                getAfter(
                  /databases/$(database)/documents/appointment_requests/$(request.resource.data.acceptedRequestId)
                ).data.payload.serviceId is string

                && getAfter(
                  /databases/$(database)/documents/appointment_requests/$(request.resource.data.acceptedRequestId)
                ).data.payload.serviceId != ""

                && request.resource.data.serviceId
                ==
                getAfter(
                  /databases/$(database)/documents/appointment_requests/$(request.resource.data.acceptedRequestId)
                ).data.payload.serviceId
              )
            )

            && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
              "serviceId",
              "acceptedRequestId"
            ])
          )

          ||

          // ---------------------------------------------------
          // CANCEL APPOINTMENT
          // ---------------------------------------------------

          (
            getAfter(
              /databases/$(database)/documents/appointment_requests/$(request.resource.data.acceptedRequestId)
            ).data.type == "cancelAppointment"

            && request.resource.data.status == "Annullata"

            && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
              "status",
              "acceptedRequestId"
            ])
          )

          ||

          // ---------------------------------------------------
          // CUSTOM
          // ---------------------------------------------------

          (
            getAfter(
              /databases/$(database)/documents/appointment_requests/$(request.resource.data.acceptedRequestId)
            ).data.type == "custom"

            && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
              "acceptedRequestId"
            ])
          )
        )
      );


      // -------------------------------------------------------
      // DELETE
      // -------------------------------------------------------

      allow delete: if
      isSalon()
      && resource.data.salonId
      == currentUser().data.salonId;
    }


    // =========================================================
    // APPOINTMENT REQUESTS
    // =========================================================

    match /appointment_requests/{requestId} {

      // -------------------------------------------------------
      // READ
      // -------------------------------------------------------

      allow read: if
      signedIn()
      && (
        (
          isSalon()
          && resource.data.salonId
          == currentUser().data.salonId
        )
        ||
        (
          isUser()
          && resource.data.customerId
          == request.auth.uid
        )
      );


      // -------------------------------------------------------
      // CREATE
      // -------------------------------------------------------

      allow create: if
      isSalon()
      && request.resource.data.id == requestId
      && request.resource.data.salonId
      == currentUser().data.salonId
      && request.resource.data.customerId is string
      && request.resource.data.customerId != ""
      && request.resource.data.appointmentId is string
      && request.resource.data.appointmentId != ""
      && request.resource.data.createdBy == "admin"
      && request.resource.data.status == "draft"
      && request.resource.data.type is string
      && request.resource.data.priority is string
      && request.resource.data.payload is map;


      // -------------------------------------------------------
      // UPDATE
      // -------------------------------------------------------

      allow update: if

      // =======================================================
      // SALON
      // =======================================================

      (
        isSalon()

        && resource.data.salonId
        == currentUser().data.salonId

        && request.resource.data.salonId
        == resource.data.salonId

        && request.resource.data.customerId
        == resource.data.customerId

        && request.resource.data.appointmentId
        == resource.data.appointmentId

        && request.resource.data.createdBy
        == resource.data.createdBy

        && request.resource.data.type
        == resource.data.type

        && request.resource.data.priority
        == resource.data.priority

        && request.resource.data.payload
        == resource.data.payload

        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
          "status",
          "updatedAt"
        ])

        && (
          (
            resource.data.status == "draft"
            && request.resource.data.status
            == "pendingCustomer"
          )
          ||
          (
            resource.data.status == "pendingCustomer"
            && (
              request.resource.data.status == "cancelled"
              || request.resource.data.status == "expired"
            )
          )
        )
      )

      ||

      // =======================================================
      // CUSTOMER
      // =======================================================
      //
      // Il customer può solamente:
      //
      // pendingCustomer -> accepted
      // pendingCustomer -> rejected
      //
      // Per accepted:
      //
      // la stessa transaction deve modificare anche
      // l'Appointment.
      //
      // =======================================================

      (
        isUser()

        && resource.data.customerId
        == request.auth.uid

        && request.resource.data.salonId
        == resource.data.salonId

        && request.resource.data.customerId
        == resource.data.customerId

        && request.resource.data.appointmentId
        == resource.data.appointmentId

        && request.resource.data.createdBy
        == resource.data.createdBy

        && request.resource.data.type
        == resource.data.type

        && request.resource.data.priority
        == resource.data.priority

        && request.resource.data.payload
        == resource.data.payload

        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
          "status",
          "updatedAt"
        ])

        && resource.data.status == "pendingCustomer"

        && (
          // ---------------------------------------------------
          // REJECTED
          // ---------------------------------------------------

          (
            request.resource.data.status == "rejected"
          )

          ||

          // ---------------------------------------------------
          // ACCEPTED
          // ---------------------------------------------------

          (
            request.resource.data.status == "accepted"

            // -------------------------------------------------
            // Appointment must be updated in the same
            // atomic operation.
            // -------------------------------------------------

            && getAfter(
              /databases/$(database)/documents/appointments/$(resource.data.appointmentId)
            ).data.userId == request.auth.uid

            && getAfter(
              /databases/$(database)/documents/appointments/$(resource.data.appointmentId)
            ).data.acceptedRequestId == requestId

            && getAfter(
              /databases/$(database)/documents/appointments/$(resource.data.appointmentId)
            ).data.salonId == resource.data.salonId

            // -------------------------------------------------
            // Appointment update must match Request type.
            // -------------------------------------------------

            && (
              // -----------------------------------------------
              // RESCHEDULE
              // -----------------------------------------------

              (
                resource.data.type == "reschedule"

                && resource.data.payload.newStart is string

                && resource.data.payload.newStart != ""

                && getAfter(
                  /databases/$(database)/documents/appointments/$(resource.data.appointmentId)
                ).data.acceptedRequestId == requestId

                && getAfter(
                  /databases/$(database)/documents/appointments/$(resource.data.appointmentId)
                ).data.date
                != get(
                  /databases/$(database)/documents/appointments/$(resource.data.appointmentId)
                ).data.date
              )

              ||

              // -----------------------------------------------
              // CHANGE EMPLOYEE
              // -----------------------------------------------

              (
                resource.data.type == "changeEmployee"

                && (
                  (
                    resource.data.payload.newEmployeeId is string
                    && resource.data.payload.newEmployeeId != ""
                    && getAfter(
                      /databases/$(database)/documents/appointments/$(resource.data.appointmentId)
                    ).data.employeeId
                    == resource.data.payload.newEmployeeId
                  )

                  ||

                  (
                    resource.data.payload.newEmployee is string
                    && resource.data.payload.newEmployee != ""
                    && getAfter(
                      /databases/$(database)/documents/appointments/$(resource.data.appointmentId)
                    ).data.employeeId
                    == resource.data.payload.newEmployee
                  )
                )
              )

              ||

              // -----------------------------------------------
              // CHANGE SERVICES
              // -----------------------------------------------

              (
                resource.data.type == "changeServices"

                && (
                  (
                    resource.data.payload.newServiceId is string
                    && resource.data.payload.newServiceId != ""
                    && getAfter(
                      /databases/$(database)/documents/appointments/$(resource.data.appointmentId)
                    ).data.serviceId
                    == resource.data.payload.newServiceId
                  )

                  ||

                  (
                    resource.data.payload.serviceId is string
                    && resource.data.payload.serviceId != ""
                    && getAfter(
                      /databases/$(database)/documents/appointments/$(resource.data.appointmentId)
                    ).data.serviceId
                    == resource.data.payload.serviceId
                  )
                )
              )

              ||

              // -----------------------------------------------
              // CANCEL APPOINTMENT
              // -----------------------------------------------

              (
                resource.data.type == "cancelAppointment"

                && getAfter(
                  /databases/$(database)/documents/appointments/$(resource.data.appointmentId)
                ).data.status == "Annullata"
              )

              ||

              // -----------------------------------------------
              // CUSTOM
              // -----------------------------------------------

              (
                resource.data.type == "custom"

                && getAfter(
                  /databases/$(database)/documents/appointments/$(resource.data.appointmentId)
                ).data.acceptedRequestId == requestId
              )
            )
          )
        )
      );


      // -------------------------------------------------------
      // DELETE
      // -------------------------------------------------------

      allow delete: if false;


      // =======================================================
      // REQUEST TIMELINE
      // =======================================================

      match /timeline/{eventId} {

        // -----------------------------------------------------
        // READ
        // -----------------------------------------------------

        allow read: if
        signedIn()
        && (
          (
            isSalon()
            &&
            get(
              /databases/$(database)/documents/appointment_requests/$(requestId)
            ).data.salonId
            == currentUser().data.salonId
          )
          ||
          (
            isUser()
            &&
            get(
              /databases/$(database)/documents/appointment_requests/$(requestId)
            ).data.customerId
            == request.auth.uid
          )
        );


        // -----------------------------------------------------
        // UPDATE / DELETE
        // -----------------------------------------------------

        allow update, delete: if false;


        // -----------------------------------------------------
        // CREATE - SALON
        // -----------------------------------------------------

        allow create: if
        isSalon()
        &&
        get(
          /databases/$(database)/documents/appointment_requests/$(requestId)
        ).data.salonId
        == currentUser().data.salonId

        && request.resource.data.id == eventId
        && request.resource.data.requestId == requestId;


        // -----------------------------------------------------
        // CREATE - USER
        // -----------------------------------------------------
        //
        // Il customer può creare eventi solamente nella stessa
        // transaction in cui risponde alla Request.
        //
        // -----------------------------------------------------

        allow create: if
        isUser()

        && get(
          /databases/$(database)/documents/appointment_requests/$(requestId)
        ).data.customerId
        == request.auth.uid

        && request.resource.data.id == eventId
        && request.resource.data.requestId == requestId

        && (
          // ---------------------------------------------------
          // ACCEPTED
          // ---------------------------------------------------

          (
            request.resource.data.type == "accepted"

            && request.resource.data.author == "customer"

            && getAfter(
              /databases/$(database)/documents/appointment_requests/$(requestId)
            ).data.status == "accepted"

            && getAfter(
              /databases/$(database)/documents/appointments/$(getAfter(
                /databases/$(database)/documents/appointment_requests/$(requestId)
              ).data.appointmentId)
            ).data.acceptedRequestId == requestId
          )

          ||

          // ---------------------------------------------------
          // REJECTED
          // ---------------------------------------------------

          (
            request.resource.data.type == "rejected"

            && request.resource.data.author == "customer"

            && getAfter(
              /databases/$(database)/documents/appointment_requests/$(requestId)
            ).data.status == "rejected"
          )

          ||

          // ---------------------------------------------------
          // APPOINTMENT UPDATED
          // ---------------------------------------------------
          //
          // Questo evento viene creato da AcceptRequestOperation.
          //
          // Il suo author è "system".
          //
          // ---------------------------------------------------

          (
            request.resource.data.type == "appointmentUpdated"

            && request.resource.data.author == "system"

            && getAfter(
              /databases/$(database)/documents/appointment_requests/$(requestId)
            ).data.status == "accepted"

            && getAfter(
              /databases/$(database)/documents/appointments/$(getAfter(
                /databases/$(database)/documents/appointment_requests/$(requestId)
              ).data.appointmentId)
            ).data.acceptedRequestId == requestId
          )
        );
      }
    }


    // =========================================================
    // EMPLOYEE CALENDAR
    // =========================================================

    match /employee_calendar/{eventId} {

      // -------------------------------------------------------
      // READ
      // -------------------------------------------------------

      allow read: if
      signedIn()
      && (
        (
          isSalon()
          && resource.data.salonId
          == currentUser().data.salonId
        )
        ||
        isUser()
      );


      // -------------------------------------------------------
      // CREATE
      // -------------------------------------------------------

      allow create: if
      isSalon()
      && request.resource.data.salonId
      == currentUser().data.salonId;


      // -------------------------------------------------------
      // UPDATE
      // -------------------------------------------------------

      allow update: if
      isSalon()
      && resource.data.salonId
      == currentUser().data.salonId
      && request.resource.data.salonId
      == currentUser().data.salonId;


      // -------------------------------------------------------
      // DELETE
      // -------------------------------------------------------

      allow delete: if
      isSalon()
      && resource.data.salonId
      == currentUser().data.salonId;
    }


    // =========================================================
    // DEFAULT DENY
    // =========================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}